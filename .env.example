# Configurações de Conexão com o SEI
# URL base do SEI (exemplo: https://sei.cbm.df.gov.br/sei ou https://sei.seusistema.gov.br/sei)
SEI_BASE_URL=https://sei.exemplo.gov.br/sei

# Credenciais de acesso ao SEI
SEI_USUARIO=seu_usuario_ou_cpf
SEI_SENHA=sua_senha_secreta

# Órgão de autenticação (sigla ou ID conforme aparece no seletor de órgão do login, ex: CBMDF, CBM, 1)
SEI_ORGAO=CBM

# (Opcional) Sigla ou ID da Unidade de trabalho padrão (ex: CBM/DTI, 110000001)
# Se não preenchido, utilizará a unidade ativa padrão do seu login
SEI_UNIDADE=

# (Opcional) Configurações de conexão HTTP
SEI_TIMEOUT=30
SEI_VERIFY_SSL=true
SEI_DEBUG=false
